{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pfg.thesis/schemas/pfg-1.0.json",
  "title": "Privilege Flow Graph",
  "description": "Frozen PFG schema v1.0. Reordering or renaming fields breaks model checkpoints.",
  "type": "object",
  "required": ["schema_version", "application", "framework", "nodes", "edges"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0" },
    "application": { "type": "string", "minLength": 1 },
    "framework": { "enum": ["django", "spring", "synthetic"] },
    "nodes": {
      "type": "array",
      "items": { "$ref": "#/$defs/node" }
    },
    "edges": {
      "type": "array",
      "items": { "$ref": "#/$defs/edge" }
    },
    "labels": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/label" }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "required": ["id", "type", "attrs"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$" },
        "type": {
          "enum": ["endpoint", "middleware", "service", "data_access"]
        },
        "attrs": { "type": "object" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "endpoint" } } },
          "then": {
            "properties": {
              "attrs": {
                "type": "object",
                "required": [
                  "http_method",
                  "route",
                  "requires_auth",
                  "required_role"
                ],
                "additionalProperties": false,
                "properties": {
                  "http_method": {
                    "enum": [
                      "GET",
                      "POST",
                      "PUT",
                      "DELETE",
                      "PATCH",
                      "OPTIONS",
                      "HEAD"
                    ]
                  },
                  "route": { "type": "string" },
                  "route_params": {
                    "type": "array",
                    "items": { "type": "string" }
                  },
                  "requires_auth": { "type": "boolean" },
                  "required_role": {
                    "enum": ["NONE", "USER", "MODERATOR", "ADMIN", "SUPERADMIN"]
                  },
                  "ownership_check_present": { "type": "boolean" },
                  "role_check_present": { "type": "boolean" },
                  "model_permission_check_present": { "type": "boolean" },
                  "object_permission_check_present": { "type": "boolean" },
                  "tenant_check_present": { "type": "boolean" },
                  "is_intentionally_public": { "type": "boolean" },
                  "source_location": { "type": "string" },
                  "has_route_params": { "type": "boolean" },
                  "reachable_data_count": { "type": "integer" },
                  "has_id_flow": { "type": "boolean" },
                  "unprotected_data_reachable": { "type": "boolean" },
                  "has_tenant_scope": { "type": "boolean" },
                  "unscoped_tenant_data_reachable": { "type": "boolean" },
                  "object_permission_data_reachable": { "type": "boolean" }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "middleware" } } },
          "then": {
            "properties": {
              "attrs": {
                "type": "object",
                "required": ["guard_type"],
                "additionalProperties": false,
                "properties": {
                  "guard_type": {
                    "enum": [
                      "AUTHENTICATION",
                      "ROLE_CHECK",
                      "OWNERSHIP_CHECK",
                      "TENANT_CHECK",
                      "OBJECT_PERMISSION_CHECK"
                    ]
                  },
                  "condition": { "type": "string" },
                  "position": { "enum": ["BEFORE_HANDLER", "INLINE"] },
                  "source_location": { "type": "string" }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "service" } } },
          "then": {
            "properties": {
              "attrs": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": { "type": "string" },
                  "inherited_privilege": {
                    "enum": ["NONE", "USER", "MODERATOR", "ADMIN", "SUPERADMIN"]
                  },
                  "performs_data_access": { "type": "boolean" },
                  "performs_mutation": { "type": "boolean" },
                  "source_location": { "type": "string" }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "data_access" } } },
          "then": {
            "properties": {
              "attrs": {
                "type": "object",
                "required": [
                  "operation",
                  "target_entity",
                  "has_ownership_predicate"
                ],
                "additionalProperties": false,
                "properties": {
                  "operation": {
                    "enum": ["READ", "WRITE", "UPDATE", "DELETE"]
                  },
                  "target_entity": { "type": "string" },
                  "has_ownership_predicate": { "type": "boolean" },
                  "ownership_predicate_type": {
                    "enum": ["DIRECT", "INDIRECT", "NONE"]
                  },
                  "has_tenant_predicate": { "type": "boolean" },
                  "requires_tenant_isolation": { "type": "boolean" },
                  "requires_object_permission": { "type": "boolean" },
                  "has_object_permission_check": { "type": "boolean" },
                  "user_controlled_params_in_query": {
                    "type": "array",
                    "items": { "type": "string" }
                  },
                  "source_location": { "type": "string" }
                }
              }
            }
          }
        }
      ]
    },
    "edge": {
      "type": "object",
      "required": ["src", "dst", "type"],
      "additionalProperties": false,
      "properties": {
        "src": { "type": "string" },
        "dst": { "type": "string" },
        "type": { "enum": ["call", "identifier_flow", "tenant_flow"] },
        "param": { "type": "string" }
      }
    },
    "label": {
      "type": "object",
      "required": ["label"],
      "additionalProperties": false,
      "properties": {
        "label": { "enum": ["SAFE", "VULNERABLE", "INTENTIONALLY_PUBLIC"] },
        "subtype": {
          "enum": [
            "MISSING_AUTH",
            "MISSING_ROLE",
            "IDOR",
            "TENANT_ISOLATION_FAILURE",
            "OBJECT_LEVEL_PERMISSION_BYPASS",
            "COMBINED"
          ]
        },
        "cwe": { "type": "string" },
        "notes": { "type": "string" }
      }
    }
  }
}
